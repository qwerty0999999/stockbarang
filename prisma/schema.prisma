generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  password      String
  avatar        String?
  role          String        @default("manajemen")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         Item[]
  transactions  Transaction[]
  loans         Loan[]
  assets        Asset[]
  logs          Log[]
  assetMovements AssetMovement[]
}

model Location {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  assets        Asset[]
  createdAt     DateTime      @default(now())
}

model Borrower {
  id            Int           @id @default(autoincrement())
  name          String
  type          String        @default("internal")
  department    String?
  phone         String?
  email         String?
  loans         Loan[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  items         Item[]
  assets        Asset[]
  createdAt     DateTime      @default(now())
}

model Brand {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  assets        Asset[]
  createdAt     DateTime      @default(now())
}

model Supplier {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  address       String?
  phone         String?
  email         String?
  items         Item[]
  assets        Asset[]
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Item {
  id            Int           @id @default(autoincrement())
  name          String
  sku           String?       @unique
  location      String?
  quantity      Int           @default(0)
  minStock      Int           @default(5)
  price         Float
  description   String?
  categoryId    Int?
  category      Category?     @relation(fields: [categoryId], references: [id])
  supplierId    Int?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  transactions  Transaction[]
  loans         Loan[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([createdAt])
}

model Asset {
  id            Int           @id @default(autoincrement())
  assetCode     String        @unique
  serialNumber  String?
  name          String
  condition     String        @default("BAIK") // BAIK, RUSAK_RINGAN, RUSAK_BERAT, HILANG
  status        String        @default("TERSEDIA") // TERSEDIA, DIPINJAM, MUTASI, AFKIR
  pic           String?
  purchaseDate  DateTime?
  price         Float?
  description   String?
  
  categoryId    Int?
  category      Category?     @relation(fields: [categoryId], references: [id])
  brandId       Int?
  brand         Brand?        @relation(fields: [brandId], references: [id])
  locationId    Int?
  location      Location?     @relation(fields: [locationId], references: [id])
  supplierId    Int?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id])
  
  loans         Loan[]
  movements     AssetMovement[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([condition])
  @@index([categoryId])
  @@index([locationId])
  @@index([createdAt])
}

model AssetMovement {
  id            Int           @id @default(autoincrement())
  assetId       Int
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromLocation  String?
  toLocation    String?
  fromPic       String?
  toPic         String?
  reason        String?
  createdAt     DateTime      @default(now())
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id])

  @@index([assetId])
  @@index([createdAt])
}

model Log {
  id            Int           @id @default(autoincrement())
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id])
  action        String
  details       String?
  createdAt     DateTime      @default(now())
}

model Transaction {
  id            Int           @id @default(autoincrement())
  type          String        // 'MASUK', 'KELUAR', 'ADJUSTMENT'
  quantity      Int
  note          String?
  reference     String?       // Opsional referensi eksternal (No. Invoice, dll)
  notes         String?
  itemId        Int
  item          Item          @relation(fields: [itemId], references: [id])
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  supplierId    Int?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([type])
  @@index([itemId])
  @@index([createdAt])
}

model Loan {
  id                  Int       @id @default(autoincrement())
  loanCode            String    @unique
  borrowerName        String?   // Nama peminjam (legacy/quick string)
  borrowerId          Int?
  borrower            Borrower? @relation(fields: [borrowerId], references: [id])
  quantity            Int       @default(1)
  status              String    @default("DIPINJAM") // 'DIPINJAM', 'DIKEMBALIKAN', 'TERLAMBAT'
  borrowDate          DateTime  @default(now())
  expectedReturnDate  DateTime? // Rencana tanggal kembali
  actualReturnDate    DateTime? // Tanggal realisasi kembali
  conditionBefore     String?   @default("BAIK")
  conditionAfter      String?
  notes               String?
  
  itemId              Int?
  item                Item?     @relation(fields: [itemId], references: [id])
  assetId             Int?
  asset               Asset?    @relation(fields: [assetId], references: [id])
  
  userId              Int       // Petugas yang mencatat
  user                User      @relation(fields: [userId], references: [id])
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([borrowerId])
  @@index([itemId])
  @@index([assetId])
  @@index([createdAt])
}