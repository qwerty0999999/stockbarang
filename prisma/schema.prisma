generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  password      String
  avatar        String?
  role          String        @default("manajemen") // admin | manajemen | dev
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         Item[]
  transactions  Transaction[]
  loans         Loan[]        // Relasi petugas yang mencatat pinjaman
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  items         Item[]
  createdAt     DateTime      @default(now())
}

model Supplier {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  address       String?
  phone         String?
  email         String?
  items         Item[]        // Barang yang disuplai oleh supplier ini (opsional)
  transactions  Transaction[] // Transaksi masuk dari supplier ini
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Item {
  id            Int           @id @default(autoincrement())
  name          String
  sku           String?       @unique
  location      String?
  quantity      Int           @default(0)
  minStock      Int           @default(5)
  price         Float
  description   String?
  categoryId    Int?
  category      Category?     @relation(fields: [categoryId], references: [id])
  supplierId    Int?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  transactions  Transaction[]
  loans         Loan[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id])
}

model Transaction {
  id            Int           @id @default(autoincrement())
  type          String        // 'MASUK', 'KELUAR', 'ADJUSTMENT'
  quantity      Int
  note          String?
  reference     String?       // Opsional referensi eksternal (No. Invoice, dll)
  notes         String?
  itemId        Int
  item          Item          @relation(fields: [itemId], references: [id])
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  supplierId    Int?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  createdAt     DateTime      @default(now())
}

model Loan {
  id                  Int       @id @default(autoincrement())
  loanCode            String    @unique
  borrowerName        String    // Nama peminjam
  quantity            Int
  status              String    @default("DIPINJAM") // 'DIPINJAM', 'DIKEMBALIKAN'
  borrowDate          DateTime  @default(now())
  expectedReturnDate  DateTime? // Rencana tanggal kembali
  actualReturnDate    DateTime? // Tanggal realisasi kembali
  notes               String?
  
  itemId              Int
  item                Item      @relation(fields: [itemId], references: [id])
  
  userId              Int       // Petugas yang mencatat
  user                User      @relation(fields: [userId], references: [id])
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}